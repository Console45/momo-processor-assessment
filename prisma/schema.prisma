// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(uuid())
  name      String    @unique
  apiKeys   ApiKey[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

model ApiKey {
  id       Int          @id @default(autoincrement())
  key      String       @unique
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  status   ApikeyStatus @default(ACTIVE)

  @@index([key, clientId])
}

model Payment {
  id               String        @id @default(uuid())
  amount           Int
  paymentReference String        @unique
  client           Client        @relation(fields: [clientId], references: [id])
  clientId         String
  paymentMethod    PaymentMethod @default(momo)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  oparator         Operator
  phoneNumber      String
  paymentData      PaymentData?  @relation(fields: [paymentDataId], references: [id])
  paymentDataId    String?       @unique
  status           PaymentStatus @default(initiated)

  @@index([paymentReference, clientId])
}

model PaymentData {
  id                        String    @id @default(uuid())
  apiResponseText           String?
  callbackResponseText      String?
  callbackResponseTime      DateTime?
  statusCheckerResponseText String?
  statusCheckerResponseTime DateTime?
  Payment                   Payment?
}

enum PaymentMethod {
  momo
}

enum Operator {
  AIRTEL_TIGO
  MTN
  VODAFONE
}

enum ApikeyStatus {
  ACTIVE
  REVOKED
}

enum PaymentStatus {
  initiated
  failed
  success
  processing
}
